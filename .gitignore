# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# PyInstaller build artifacts (the distributable is uploaded to Releases,
# not committed). The .spec and build.bat ARE tracked.
build/
dist/
*.manifest

# Virtual environment — each user runs setup.bat to create their own
venv/
env/
.venv/

# Runtime data — personal and machine-specific, not for sharing
config.json
history.json
dictionary.json
pending_corrections.json
cait-whisper.log
# Rotated log files (.log.1, .log.2, etc.) created by the rotating handler
cait-whisper.log.*
# Atomic-write temp files that got orphaned from a crashed write
*.tmp

# Downloaded model weights (large, re-downloaded on first run)
*.onnx
*.ot
models/
model_cache/

# Hugging Face / PyTorch caches
.cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code (development tooling)
.claude/

# Dev preview renders (PIL output during design iteration)
preview/
